# Mike hybrid brain configuration
# Local brain (default)
MIKE_LOCAL_URL=http://localhost:11434/v1/chat/completions
MIKE_LOCAL_MODEL=

# Global brain (used when local is unreachable)
# Path B: NVIDIA build API (recommended) - https://build.nvidia.com
MIKE_GLOBAL_URL=https://integrate.api.nvidia.com/v1/chat/completions
MIKE_GLOBAL_KEY=
MIKE_GLOBAL_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Path A: OpenRouter (free Nemotron 3.5) - https://openrouter.ai
# MIKE_GLOBAL_URL=https://openrouter.ai/api/v1/chat/completions
# MIKE_GLOBAL_KEY=
# MIKE_GLOBAL_MODEL=nvidia/nemotron-3.5-lightning:free

# Remote interface (V0.5 - talk to Mike from your phone)
# On your phone (same WiFi) open: http://<pc-ip>:8877
# One-time: run as admin -> python -m interfaces.remote.firewall enable
MIKE_REMOTE_KEY=

# Email sending (Gmail app password - Google Account -> Security ->
# 2-Step Verification -> App passwords)
MIKE_EMAIL_ADDRESS=
MIKE_EMAIL_APP_PASSWORD=